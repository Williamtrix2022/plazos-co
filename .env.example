# ============================================================
# Plazos.co — Variables de entorno (ejemplo)
# Copia este archivo como .env y llena los valores.
# NUNCA subas .env al repositorio.
# ============================================================

# ----- Base de datos -----
DATABASE_URL=postgresql://plazos:secret@localhost:5432/plazos_dev

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- API de Claude (IA) -----
ANTHROPIC_API_KEY=sk-ant-...

# ----- Backend -----
SECRET_KEY=cambia-esto-por-algo-seguro
ENVIRONMENT=development
DEBUG=true

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
